# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real values.

# App
APP_ENV=development                 # development | demo (hosted competition demo) | production
DEMO_MODE=true                      # enables demo accounts and the synthetic banner; false in production
DATABASE_URL=sqlite:///./hishab.db  # production: postgresql+psycopg://user:pass@db:5432/hishab
SECRET_KEY=change-me                # 32+ random bytes; sessions and HMAC tokens
VAULT_KEY=change-me                 # 32 random bytes (base64); AES-256-GCM token vault

# LLM providers (free tiers) — created by Amdad, see docs/RUNBOOK.md §4.1
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODE=fixtures                   # fixtures | live | deterministic

# Testnet (server only) — created by Labib, see docs/RUNBOOK.md §4.3
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CHAIN_MODE=offline                  # offline | sepolia

# Messaging (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
